# Copy this file to .env or export these variables in your shell.
ETA_CODE_DIR=/path/to/eta
ETA_WORK_DIR=/path/to/eta

# Zenodo archives backing this repository.
ETA_SAMPLE_DATA_DOI=10.5281/zenodo.21635446
ETA_MODEL_ARCHIVE_DOI=10.5281/zenodo.21635468

# Filled when the GitHub release mints the code archive DOI.
ETA_CODE_ARCHIVE_DOI=10.5281/zenodo.21636107

# Checksum manifests published inside the records above.
ETA_ASSET_CHECKSUMS="SHA256SUMS-data.txt, SHA256SUMS-models-samples.txt"
ETA_ASSET_LICENSE="CC-BY-4.0 (ERA5-Land files also subject to the Licence to Use Copernicus Products)"
